# APEX Trading System v4.0 — Environment Variables Template
# Copy this file to .env and fill in real values. DO NOT commit .env to git.

ENV=development
LOG_LEVEL=INFO
DEBUG=False

# ─────────────────────────────────────────────────────────
# DATABASES (Match docker-compose.yml values)
# ─────────────────────────────────────────────────────────
DB_TIMESCALE_HOST=timescaledb
DB_TIMESCALE_PORT=5432
DB_TIMESCALE_NAME=apex
DB_TIMESCALE_USER=apex
DB_TIMESCALE_PASSWORD=your_secure_password_here

DB_REDIS_HOST=redis
DB_REDIS_PORT=6379
DB_REDIS_PASSWORD=your_secure_redis_password

DB_CLICKHOUSE_HOST=clickhouse
DB_CLICKHOUSE_PORT=9000
DB_CLICKHOUSE_NAME=apex
DB_CLICKHOUSE_USER=default
DB_CLICKHOUSE_PASSWORD=your_secure_clickhouse_password

DB_MINIO_ENDPOINT=minio:9000
DB_MINIO_ACCESS_KEY=admin
DB_MINIO_SECRET_KEY=admin123

# ─────────────────────────────────────────────────────────
# EXCHANGES
# ─────────────────────────────────────────────────────────
EXCHANGE_BINANCE_API_KEY=your_binance_api_key
EXCHANGE_BINANCE_API_SECRET=your_binance_api_secret

EXCHANGE_BYBIT_API_KEY=your_bybit_api_key
EXCHANGE_BYBIT_API_SECRET=your_bybit_api_secret

EXCHANGE_OKX_API_KEY=your_okx_api_key
EXCHANGE_OKX_API_SECRET=your_okx_api_secret
EXCHANGE_OKX_PASSPHRASE=your_okx_passphrase

# ─────────────────────────────────────────────────────────
# AI AUDIT (Required for execution)
# ─────────────────────────────────────────────────────────
AI_ANTHROPIC_API_KEY=sk-ant-api03-...
AI_OPENAI_API_KEY=sk-proj-...
AI_PRIMARY_MODEL=claude-3-7-sonnet-20250219

# ─────────────────────────────────────────────────────────
# DATA SOURCES (On-chain, Social, Macro)
# ─────────────────────────────────────────────────────────
DATASOURCE_GLASSNODE_API_KEY=your_glassnode_key
DATASOURCE_CRYPTOQUANT_API_KEY=your_cryptoquant_key
DATASOURCE_LUNARCRUSH_API_KEY=your_lunarcrush_key
DATASOURCE_FRED_API_KEY=your_fred_key

# ─────────────────────────────────────────────────────────
# ALERTS & MONITORING
# ─────────────────────────────────────────────────────────
ALERT_TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
ALERT_TELEGRAM_CHAT_ID=-1001234567890
ALERT_TELEGRAM_ERROR_CHAT_ID=-1000987654321

# ─────────────────────────────────────────────────────────
# TRADING LIMITS
# ─────────────────────────────────────────────────────────
TRADING_INITIAL_DEPOSIT_USD=10000.0
TRADING_MIN_RISK_PCT=0.25
TRADING_MAX_RISK_PCT=2.0
TRADING_DAILY_LOSS_STOP_PCT=3.0
TRADING_DRAWDOWN_STOP_PCT=15.0
